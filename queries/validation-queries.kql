// Replace the values below with the UPNs from baseline-config.json.
let DemoUsers = dynamic([
    "sales.user1@contoso.onmicrosoft.com",
    "sales.user2@contoso.onmicrosoft.com",
    "sales.user3@contoso.onmicrosoft.com",
    "finance.user1@contoso.onmicrosoft.com",
    "finance.user2@contoso.onmicrosoft.com",
    "finance.user3@contoso.onmicrosoft.com",
    "engineering.user1@contoso.onmicrosoft.com",
    "engineering.user2@contoso.onmicrosoft.com"
]);

// 1. Interactive and silent authentication generated by the orchestrator.
union SigninLogs, AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(7d)
| where UserPrincipalName in~ (DemoUsers)
| summarize
    Events=count(),
    Successful=countif(ResultType == "0"),
    LastSeen=max(TimeGenerated),
    Apps=make_set(AppDisplayName, 20),
    IPs=make_set(IPAddress, 10)
    by UserPrincipalName
| order by UserPrincipalName asc

// 2. Microsoft 365 workload activity. Zero total workspace records indicates
// that the Microsoft 365/Office 365 connector is not delivering audit data.
OfficeActivity
| where TimeGenerated > ago(7d)
| where UserId in~ (DemoUsers)
| summarize
    Events=count(),
    LastSeen=max(TimeGenerated),
    Operations=make_set(Operation, 30),
    Workloads=make_set(OfficeWorkload, 10)
    by UserId
| order by UserId asc

// 3. Confirm that Sentinel has calculated peer relationships.
UserPeerAnalytics
| where TimeGenerated > ago(7d)
| where UserPrincipalName in~ (DemoUsers)
| summarize
    PeerRecords=count(),
    DistinctPeers=dcount(PeerUserId),
    LastCalculated=max(TimeGenerated)
    by UserPrincipalName
| order by UserPrincipalName asc

// 4. Review UEBA-enriched behavior.
BehaviorAnalytics
| where TimeGenerated > ago(30d)
| where UserPrincipalName in~ (DemoUsers)
| project
    TimeGenerated,
    TimeProcessed,
    UserPrincipalName,
    ActivityType,
    ActionType,
    InvestigationPriority,
    ActivityInsights,
    SourceIPAddress,
    SourceIPLocation,
    NativeTableName
| order by InvestigationPriority desc, TimeGenerated desc

// 5. Confirm whether OfficeActivity has any data at all.
OfficeActivity
| where TimeGenerated > ago(30d)
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated)

